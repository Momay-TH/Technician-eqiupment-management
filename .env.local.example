# Local / runtime environment variables (none of these are secrets used by the app at runtime;
# secrets for Cloudflare are set with `wrangler secret put <NAME>`).

# Public base URL of the app (used for absolute links, e.g. QR targets).
NEXT_PUBLIC_APP_URL=http://localhost:8788

# One-time bootstrap token. When set, POST /api/auth/bootstrap requires the header
# `x-bootstrap-token: <value>` and is disabled in production without it.
# Set on Cloudflare with:  wrangler secret put BOOTSTRAP_TOKEN
# BOOTSTRAP_TOKEN=change-me-to-a-long-random-string
